# Copy this file to `.env` and adjust values if needed:
#   cp .env.example .env
# The Makefile and scripts load `.env` automatically when it exists.
# No credentials are required for the local PLAINTEXT broker used in M1.

# Address the Python apps use to reach Kafka (the broker's EXTERNAL listener).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic that carries raw simulated telemetry.
KAFKA_TOPIC=research.telemetry.raw

# Topic that carries baseline anomaly alerts (M2).
KAFKA_ALERTS_TOPIC=research.telemetry.alerts

# Topic that carries ADWIN concept drift events (M3).
KAFKA_DRIFT_TOPIC=research.telemetry.drift

# Number of partitions / replication factor used by scripts/create_topic.sh.
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# Consumer group used by `make consumer`.
KAFKA_CONSUMER_GROUP=driftguard-m1-consumer

# Client identifier visible in broker logs.
KAFKA_CLIENT_ID=driftguard-m1

# Number of simulated machines (machine_01 ... machine_NN).
SIMULATOR_MACHINE_COUNT=5

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
