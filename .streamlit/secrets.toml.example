# Copy to `.streamlit/secrets.toml` for local testing, or paste into
# Streamlit Community Cloud -> App Settings -> Secrets.
# NEVER commit `.streamlit/secrets.toml` to Git.
#
# Use ONLY the read-only subscriber account (`streamlit_readonly` or equivalent)
# for public / shared dashboards. Keep the command token optional or unset for
# public viewers; set it only if authorized operators may switch device profiles.

[mqtt]
broker_host = "your-cloud-broker.example.com"
broker_port = 8883
use_tls = true
username = "streamlit_readonly"
password = "CHANGE_ME_READONLY_PASSWORD"
namespace = "driftguard/YOUR_PRIVATE_NAMESPACE"
client_id = "driftguard-streamlit-cloud-viewer"
qos = 1

# Optional: only set in trusted deployments where operators may switch profiles
# from the Device Management tab.
# command_token = "CHANGE_ME_COMMAND_TOKEN"
# allow_profile_control = false
